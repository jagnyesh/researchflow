{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push *--force*)",
      "Bash(git push *--delete*)",
      "Bash(git branch -d*)",
      "Bash(git branch -D*)",
      "Bash(git branch --delete*)",
      "Bash(rm -r*)",
      "Bash(rm -fr*)",
      "Bash(rm -Rf*)",
      "Bash(rm -R*)",
      "Bash(git push -d*)",
      "Bash(git push * -d*)",
      "Bash(git push * +*)",
      "Bash(rm -fR*)",
      "Bash(rm -f -r*)",
      "Bash(rm * -r*)",
      "Bash(rm * -R*)",
      "Bash(rm *--recursive*)"
    ],
    "deny": [
      "Read(//**/.env)",
      "Read(~/.ssh/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/PreToolUse.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/PostToolUse.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/SessionStart.sh"
          }
        ]
      }
    ]
  }
}
